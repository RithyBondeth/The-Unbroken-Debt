{
  "name": "boon-sop-the-unbroken-debt",
  "version": "0.1.0",
  "private": true,
  "description": "Boon Sop: The Unbroken Debt — a first-person survival horror game for the web (Babylon.js, WebGPU)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "assets": "node tools/build-assets.mjs",
    "docs": "bash tools/build-docs.sh"
  },
  "dependencies": {
    "@babylonjs/core": "9.31.0",
    "@babylonjs/gui": "9.31.0",
    "@babylonjs/havok": "1.3.14",
    "@babylonjs/loaders": "9.31.0",
    "idb-keyval": "6.3.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
