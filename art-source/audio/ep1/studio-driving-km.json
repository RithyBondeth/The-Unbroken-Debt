    {
      "key": "taxi_sora_5",
      "role": "sora",
      "text": "ពូ… មិញពូឃើញអត់? ដូចមានអ្នកណាឈរកណ្ដាលផ្លូវ។",
      "asset": "vo_taxi_sora_km_5"
    },
    {
      "key": "taxi_driver_5",
      "role": "driver",
      "text": "ក្មួយ មើលទៅមុខទៅ។ កុំហៅវាអី។",
