# Normalise text line endings
* text=auto eol=lf

# Binary files tracked with Git LFS. Install Git LFS (git lfs install) before adding any of these.
art-source/**/*.blend filter=lfs diff=lfs merge=lfs -text
art-source/**/*.psd   filter=lfs diff=lfs merge=lfs -text
art-source/**/*.kra   filter=lfs diff=lfs merge=lfs -text
art-source/**/*.exr   filter=lfs diff=lfs merge=lfs -text
art-source/**/*.tif   filter=lfs diff=lfs merge=lfs -text
art-source/**/*.png   filter=lfs diff=lfs merge=lfs -text
art-source/**/*.wav   filter=lfs diff=lfs merge=lfs -text
art-source/**/*.mp3   filter=lfs diff=lfs merge=lfs -text
art-source/**/*.ogg   filter=lfs diff=lfs merge=lfs -text
public/assets/**/*.glb  filter=lfs diff=lfs merge=lfs -text
public/assets/**/*.ktx2 filter=lfs diff=lfs merge=lfs -text
public/assets/**/*.ogg  filter=lfs diff=lfs merge=lfs -text
public/assets/**/*.m4a  filter=lfs diff=lfs merge=lfs -text

# Binary files kept in normal Git
*.pdf binary
*.ttf binary
