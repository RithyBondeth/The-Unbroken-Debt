# Dependencies and build output
node_modules/
dist/
coverage/
.vite/

# Intermediate art exports (regenerated from art-source/ by Blender)
art-export/*
!art-export/README.md

# Spike S3 test room: generated by tools/s3/make_test_room.py
art-source/blender/spikes/
art-source/textures/s3/

# Library assets: re-downloaded by `npm run fetch-library` from the committed manifest
art-source/library/*
!art-source/library/polyhaven.json
# Sketchfab scans have no download manifest (downloads need an account): kept in LFS.
!art-source/library/scans/
# Motion capture (CMU, free for commercial use): the source of the ghosts' clips.
!art-source/library/mocap/

# Reference images are for study only and may be copyrighted
art-source/reference/*
!art-source/reference/README.md

# Blender backups
*.blend1
*.blend2

# OS and editor files
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# Spike screenshots saved by the dev server (src/debug/saveShot.ts)
debug-shots/

# Decoders copied from node_modules by tools/vendor-decoders.mjs (npm install)
public/vendor/

# Python bytecode from the Blender area scripts
__pycache__/

# Local scratch: image-generation and palette-review output, editor tool caches
output/
.impeccable/

# Episode 2 stupa and statue kit and baked maps: regenerated by tools/ep2/build-stupas.py
# and tools/ep2/build-ghosts.py; hundreds of MB, and packed into the area .blend anyway.
art-source/kits/
art-source/textures/ep2/T_ep2_stupa_*
art-source/textures/ep2/T_ep2_image_*
art-source/textures/ep2/T_ep2_guardian_*
art-source/textures/ep2/T_ep2_naga_rail_*
art-source/textures/ep2/T_ep2_sema_stone_*
art-source/textures/ep2/T_ep2_spirit_house_*
art-source/textures/ep2/T_ep2_hall_throne_*
art-source/textures/ep2/T_ep2_funeral_photos_*
art-source/textures/ep2/T_ep2_kmaoch_*
