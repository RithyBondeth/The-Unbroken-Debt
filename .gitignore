# Dependencies and build output
node_modules/
dist/
coverage/
.vite/

# Intermediate art exports (regenerated from art-source/ by Blender)
art-export/*
!art-export/README.md

# Spike S3 test room: generated by tools/s3/make_test_room.py
art-source/blender/spikes/
art-source/textures/s3/

# Library assets: re-downloaded by `npm run fetch-library` from the committed manifest
art-source/library/*
!art-source/library/polyhaven.json

# Reference images are for study only and may be copyrighted
art-source/reference/*
!art-source/reference/README.md

# Blender backups
*.blend1
*.blend2

# OS and editor files
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# Spike screenshots saved by the dev server (src/debug/saveShot.ts)
debug-shots/

# Decoders copied from node_modules by tools/vendor-decoders.mjs (npm install)
public/vendor/

# Python bytecode from the Blender area scripts
__pycache__/
