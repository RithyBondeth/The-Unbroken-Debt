  "takes": [
    {
      "key": "studio_letters",
      "role": "sora",
      "text": "សំបុត្រយាយ… យប់នេះ ខ្ញុំអានមិនកើតទេ។",
      "asset": "vo_studio_km_E1-P03-1"
    },
    {
      "key": "studio_call1",
      "role": "mey",
      "text": "សូរ៉ា? សូរ៉ា ចៅមែនទេ? ឮយាយនិយាយទេ ចៅ?",
      "asset": "vo_studio_km_E1-P06-1"
    },
    {
      "key": "studio_call2",
      "role": "sora",
      "text": "យាយ? មានរឿងអីយាយ? ម៉ោងប្រាំបីជាងហើយ…",
      "asset": "vo_studio_km_E1-P06-2"
    },
    {
      "key": "studio_call3",
      "role": "mey",
      "text": "ចៅមកផ្ទះវិញមក។ មកឥឡូវនេះ! ពូសុខធ្វើឱ្យវាបែកហើយ… វានៅក្នុងផ្ទះ។",
      "asset": "vo_studio_km_E1-P06-3"
    },
    {
      "key": "studio_call4",
      "role": "sora",
      "text": "យាយ? យាយឮខ្ញុំទេ? យាយ!",
      "asset": "vo_studio_km_E1-P06-4"
    },
    {
      "key": "taxi_driver_1",
      "role": "driver",
      "text": "ផ្លូវលិចទឹកអស់ហើយ។ មានគេចាំក្មួយនៅផ្ទះទេ?",
