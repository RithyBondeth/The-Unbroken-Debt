      "role": "sora",
      "text": "យាយខ្ញុំទូរស័ព្ទមក។ ខ្ញុំទៅផ្ទះពូសុខ។",
      "asset": "vo_taxi_sora_km_1"
    },
    {
      "key": "taxi_driver_2",
      "role": "driver",
      "text": "ព្រឹកមិញ ពូទើបតែដឹកអ្នកទៅបុណ្យសពនៅទីនោះ។",
      "asset": "vo_taxi_driver_km_2"
    },
    {
      "key": "taxi_sora_2",
      "role": "sora",
      "text": "ខ្ញុំខានមកផ្ទះច្រើនឆ្នាំហើយ។ មើលទៅប្លែកណាស់។",
      "asset": "vo_taxi_sora_km_2"
    },
    {
      "key": "taxi_driver_3",
      "role": "driver",
      "text": "ដើមឈើធំអស់ហើយ… តែផ្លូវនៅដដែល។",
